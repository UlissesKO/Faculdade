package main;

import java.util.Scanner; //Para fazer os inputs

//O nome da classe tem que ser o nome do arquivo
public class main {
	public static void main(String[] args) {

		int opc = 0; //Variavel para setar as escolhas do menu

		// criando o objeto da classe Scanner (entrada de dados)
		Scanner entrada = new Scanner ( System.in );

		// criando o objeto da classe Conta
		conta conta1 = new conta();

		// entrada de dados
		System.out.print("Digite o Número da Conta: ");
		conta1.setNro_Conta(entrada.nextInt());

		System.out.print("Digite a agência: ");
		conta1.setAgencia(entrada.nextInt());

		System.out.print("Digite o Nome: ");
		conta1.setNome(entrada.next());

		System.out.print("Digite o saldo da conta: ");
		conta1.setSaldo(entrada.nextFloat());

        // menu
		while (opc >= 4) {
			System.out.println("========== Escolha a opção ========= ");
			System.out.println("[ 1 ] - Mostrar os dados da Conta");
			System.out.println("[ 2 ] - Depositar na Conta");
			System.out.println("[ 3 ] - Sacar dinheiro da Conta");
			System.out.println("[ 4 ] - Encerrar o programa");
			System.out.print("Escolha sua opção: ");	
			opc = entrada.nextInt();
			if (opc == 1) {
				conta1.MostrarDados();
			} else {
				if (opc == 2) {
					System.out.println("Confira o saldo: (Pobre fudido)");
					conta1.Depositar((entrada.nextFloat()) / 2);
				} else {
					if (opc == 3) {
						System.out.println("Quanto quer sacar? ");
						conta1.Sacar(entrada.nextFloat());
					} else {
						System.out.println("Adeus, pobre miserável!");
					}
				}
			}
		}

	}
}
