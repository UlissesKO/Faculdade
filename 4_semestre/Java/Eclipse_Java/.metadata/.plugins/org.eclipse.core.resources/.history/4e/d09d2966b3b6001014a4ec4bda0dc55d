package main;

public class conta {
	private int nro_conta, agencia;

	private float saldo;

	private String nome;



	// getters e setters

	public void setNro_Conta(int num)		{ 		this.nro_conta = num;	 }

	public void setAgencia(int age)		{		this.agencia   = age;	 }

	public void setSaldo(float valor)		{		this.saldo     = valor; }

	public void setNome(String nome)		{		this.nome = nome;		 }



	public int getNro_Conta()		{		return this.nro_conta;		}

	public int getAgencia()			{		return this.agencia;		}

	public float getSaldo()			{		return this.saldo;			}

	public String getNome()			{		return this.nome;			}



	// metodos

	public void MostrarDados()	{

		System.out.println("======== Dados da Conta ========");

		System.out.println("Número da Conta  : " + this.getNro_Conta());

		System.out.println("Agência da Conta : " + this.getAgencia());

		System.out.println("Proprietário     : " + this.getNome());

		System.out.println("Saldo na Conta   : " + this.getSaldo());

		System.out.println("================================");

	}



	public void Depositar(float _valor) {

		this.setSaldo(this.getSaldo() + _valor);

	}



	public void Sacar(float _valor) {

		this.setSaldo(this.getSaldo() - _valor);

	}


}
